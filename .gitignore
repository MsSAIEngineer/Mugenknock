# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code のローカル設定（マシン固有・コミット不要）
.claude/

# Amplify ローカル設定（マシン固有）
amplify-backup/.config/local-aws-info.json
amplify-backup/.config/local-env-info.json

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 問題JSONファイル（インポート用データ）
questions/*.json

# 夜間バッチ（prompts/）
# スクリプトと、バッチが改良する資産（instructions/*.txt・state/service-catalog.json）は追跡する。
# 資産はバッチ自身が scripts/commit-night-assets.sh で develop にコミットする（2026-10-27〜）。
# 実行のたびに書き換わるログと実行状態は無視する（作業ツリーに溜めない。手の変更と混ざると巻き込み事故の元）。
#   ※ 以前は prompts/ ごと無視したうえで末尾に !prompts/ で打ち消しており、
#     結局全ファイルが追跡され、夜間バッチが走るたび git status が数百行汚れていた。
prompts/logs/
prompts/night-prompts/logs/
prompts/night-prompts/e2e/canary-results/
prompts/.claude_history
prompts/.night_history
prompts/.last_run
prompts/.last_run_date
prompts/.ct-hooks
prompts/.hook-exec-*.sh
prompts/night-prompts/.oci_rate_limit_reset
prompts/night-prompts/.claude_rate_limit_reset
prompts/tips_backup_*.json
prompts/night-prompts/scripts/__pycache__/
prompts/night-prompts/scripts/instructions/*.bak
prompts/night-prompts/scripts/state/*
!prompts/night-prompts/scripts/state/service-catalog.json

# TypeScript のビルドキャッシュ（生成物）
tsconfig.tsbuildinfo

# Amplify Gen 1 legacy (archived)
amplify_gen1/\#current-cloud-backend
amplify_gen1/.config/local-*
amplify_gen1/logs
amplify_gen1/mock-data
amplify_gen1/mock-api-resources
amplify_gen1/backend/amplify-meta.json
amplify_gen1/backend/.temp
build/
dist/
node_modules/
aws-exports.js
awsconfiguration.json
amplifyconfiguration.json
amplifyconfiguration.dart
amplify-build-config.json
amplify-gradle-config.json
amplifytools.xcconfig
.secret-*
**.sample

# Amplify Gen 2
.amplify/

# Capacitor Android
android/.gradle/
android/app/build/
android/build/
android/local.properties

# Playwright E2E
e2e/.auth/
e2e/test-results/
e2e/reports/
e2e/screenshots/
.next/
out/
